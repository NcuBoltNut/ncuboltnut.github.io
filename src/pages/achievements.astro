---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/achievements.css';
import { getCollection } from 'astro:content';

const entries = await getCollection('achievements');

function byCategory(category: 'competition' | 'robot' | 'academic' | 'milestone') {
  return entries
    .filter((e) => e.data.category === category)
    .sort((a, b) => a.data.order - b.data.order);
}

const competitions = byCategory('competition');
const robots = byCategory('robot');
const academics = byCategory('academic');
const milestones = byCategory('milestone');
---

<BaseLayout
  title="成就 — NCU BoltNut Robotics"
  description="NCU BoltNut Robotics 競賽成就 — 國研盃智慧機械競賽、TEL Robot Combat 東京威力科創機器人大賽亞軍、英文演講第2名、獵爪清道夫機器人。"
  navActive="achievements"
>
  <section class="page-header fade-up">
    <span class="eyebrow">Achievements</span>
    <h1>競賽成就 / ACHIEVEMENTS</h1>
    <p>BoltNut 在競賽舞台上留下的足跡與成績</p>
  </section>

  <section class="ach-main fade-up-1">
    {competitions.map(({ id, data }) => (
      <div id={id} class="ach-record">
        <span class="eyebrow" style="font-size:19px;">{data.subtitle}</span>
        <h2>{data.title}</h2>
        {data.body && <p><Fragment set:html={data.body} /></p>}
        {data.date && <span class="ach-date-pill">{data.date}</span>}
      </div>
    ))}
  </section>

  <section class="robot-section fade-up-2">
    <div class="section-rule section-head">
      <span class="eyebrow">Our Robot</span>
      <h2>競賽機器人</h2>
    </div>
    {robots.map(({ id, data }, i) => (
      <div id={id} class="robot-box" style={i > 0 ? 'margin-top:24px;' : undefined}>
        <div class="robot-box-text">
          <h3>{data.title}</h3>
          <p class="robot-sub">{data.subtitle}</p>
          {data.tags && (
            <div class="robot-tags">
              {data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          )}
          {data.body && (
            <p style="font-size:14.5px; color:var(--muted); line-height:1.75; margin-top:16px;">
              <Fragment set:html={data.body} />
            </p>
          )}
        </div>
        {data.photo && (
          <div class="box-photo"><img src={data.photo} alt={data.title} /></div>
        )}
      </div>
    ))}

    <div style="text-align:center; margin-top:32px;">
      <a href="https://www.youtube.com/watch?v=6lmuoDU2aDk" target="_blank" rel="noopener" class="btn btn-dark">Robot Reveal ↗</a>
    </div>
  </section>

  <section class="academic-section fade-up-3">
    <div class="section-rule section-head">
      <span class="eyebrow">Academic</span>
      <h2>學術成就</h2>
    </div>
    {academics.map(({ id, data }, i) => (
      <div id={id} class="academic-box" style={i > 0 ? 'margin-top:24px;' : undefined}>
        <div class="academic-box-text">
          <h3>{data.title}</h3>
          {data.rank && <div class="academic-rank">{data.rank}</div>}
          {data.body && <p><Fragment set:html={data.body} /></p>}
        </div>
        {data.photo && (
          <div class="box-photo">
            <img src={data.photo} alt={data.title} style={data.photoStyle} />
          </div>
        )}
      </div>
    ))}
  </section>

  <section class="robot-section fade-up-3">
    <div class="section-rule section-head">
      <span class="eyebrow">Other Milestones</span>
      <h2>其他重要成果</h2>
    </div>
    <div class="info-grid">
      {milestones.map(({ id, data }) => (
        <div id={id} class="info-cell">
          <p style="font-size:17px; font-weight:700; color:var(--ink); margin-bottom:10px;">{data.title}</p>
          {data.body && <p><Fragment set:html={data.body} /></p>}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
