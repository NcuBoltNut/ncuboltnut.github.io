---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/sponsors.css';
import { sponsors } from '../data/sponsors';

const sortedSponsors = [...sponsors].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="贊助商專區 — NCU BoltNut Robotics"
  description="認識支持 NCU BoltNut Robotics 的贊助夥伴，以及如何成為我們的贊助商。"
  navActive="sponsors"
>
  <section class="page-header fade-up">
    <span class="eyebrow">Our Partners</span>
    <h1>贊助商專區 / SPONSORS</h1>
    <p>感謝各界夥伴的支持，讓 BoltNut 得以持續在機器人競賽舞台上前進</p>
  </section>

  <section id="sponsors" class="sponsor-section fade-up-1">
    <div class="section-head" style="margin-bottom:32px;">
      <span class="eyebrow">Sponsors</span>
      <h2>贊助商介紹</h2>
    </div>
    <div class="sponsor-detail-list">
      {sortedSponsors.map((sponsor) => (
        <div class="sponsor-detail-row">
          <div class="sponsor-detail-logo"><img src={sponsor.logo} alt={`${sponsor.name} Logo`} /></div>
          <div class="sponsor-detail-text">
            <p class="name">{sponsor.name}<span>　{sponsor.nameEn}</span></p>
            <p>{sponsor.blurb}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="sponsor-how" class="sponsor-section fade-up-2" style="padding-top:0;">
    <div class="section-rule section-head">
      <span class="eyebrow">Partner With Us</span>
      <h2>如何贊助我們</h2>
    </div>
    <div class="info-grid">
      <div class="info-cell">
        <span class="eyebrow">經費贊助</span>
        <p>支持零件採購、加工與差旅經費，協助團隊順利完成競賽備戰。</p>
      </div>
      <div class="info-cell">
        <span class="eyebrow">技術合作</span>
        <p>提供設備、軟體授權或技術指導，與我們一同精進工程實作能力。</p>
      </div>
      <div class="info-cell">
        <span class="eyebrow">品牌曝光</span>
        <p>於官網、社群與競賽現場展示貴公司標誌，提升品牌在校園與業界的能見度。</p>
      </div>
    </div>
    <p class="sponsor-how-note">歡迎透過 <a href="mailto:ncuboltnutrobotics@gmail.com">ncuboltnutrobotics@gmail.com</a> 與我們聯繫洽談贊助方案。</p>
  </section>
</BaseLayout>
