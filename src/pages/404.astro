---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面 — NCU BoltNut Robotics" description="找不到指定的 NCU BoltNut Robotics 網頁。">
  <div style="min-height:60vh;display:grid;place-items:center;padding:32px;text-align:center;">
    <div>
      <p class="eyebrow">404 / PAGE NOT FOUND</p>
      <h1 style="font-family:var(--font-title);font-size:clamp(32px,6vw,64px);margin:12px 0;">找不到這個頁面</h1>
      <p style="color:var(--muted);margin:0 0 28px;">網址可能已變更，或頁面目前不存在。</p>
      <a class="btn btn-orange" href="/">返回 BoltNut 首頁</a>
    </div>
  </div>
</BaseLayout>
