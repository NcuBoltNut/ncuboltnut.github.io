---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/home.css';
import '../styles/pages/achievements.css';
import { getCollection } from 'astro:content';
import { sponsors } from '../data/sponsors';

const newsEntries = await getCollection('news');
newsEntries.sort((a, b) => a.data.order - b.data.order);
const latestNews = newsEntries[0];

function pad(n: number) {
  return String(n).padStart(2, '0');
}
function formatDate(d: Date) {
  return `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
}

const sortedSponsors = [...sponsors].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="NCU BoltNut Robotics — 首頁"
  description="NCU BoltNut Robotics — 國立中央大學機械工程學系機器人團隊，成立於 2025 年，致力於國研盃智慧機械競賽等國際機器人競賽。"
  navOverlay
  navActive="home"
>
  <section class="hero">
    <div class="hero-video-wrap">
      <iframe
        src="https://www.youtube.com/embed/aD9Q8hKHNbc?autoplay=1&mute=1&loop=1&playlist=aD9Q8hKHNbc&controls=0&showinfo=0&modestbranding=1&rel=0&playsinline=1"
        title="NCU BoltNut Robotics"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
    <div class="hero-scrim"></div>
    <div class="hero-inner">
      <p class="hero-pre">NCU Mechanical Engineering · Est. 2025</p>
      <h1 class="hero-sub">NCU <span class="accent">Bolt</span>Nut</h1>
      <h1 class="hero-title">ROBOTICS</h1>
      <p class="hero-tagline">"Bolt together, Nuts going anywhere."</p>
      <div class="hero-cta">
        <a href="#about" class="btn btn-orange">關於我們 →</a>
        <a href="/contact" class="btn btn-outline-white">聯絡我們</a>
      </div>
    </div>
    <div class="hero-scroll">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </section>

  {latestNews && (
    <section class="news-teaser">
      <div class="news-teaser-row">
        <div>
          <span class="eyebrow" style="margin-bottom:8px;">Latest Updates</span>
          <h2>最新動態</h2>
        </div>
        <a href="/news" class="news-teaser-link">查看全部動態 →</a>
      </div>
      <a href="/news" class="news-teaser-card">
        <span class="date">{formatDate(latestNews.data.date)}</span>
        <div class="news-teaser-card-body">
          <h3>{latestNews.data.title}</h3>
          <p set:html={latestNews.data.summary} />
        </div>
      </a>
    </section>
  )}

  <section class="photo-band-full">
    <img src="/hero-team.jpg" alt="NCU BoltNut Robotics 團隊合照" />
    <div class="photo-band-scrim"></div>
    <div class="photo-band-inner">
      <span class="eyebrow">The Team</span>
      <h2>每一顆螺栓，都不可或缺</h2>
    </div>
  </section>

  <section id="about" class="about-teaser" style="border-top:1px solid var(--line2); padding-top:clamp(56px,8vw,88px);">
    <div class="about-teaser-text">
      <span class="eyebrow">About Us</span>
      <h2>誰是 <span>BoltNut</span>？</h2>
      <p>NCU BoltNut Robotics 是由國立中央大學機械工程學系學生於 2025 年自主創立的機器人團隊，以國研盃智慧機械競賽等國際競賽為核心目標，透過密集訓練與跨領域合作，培養實戰能力與工程素養。</p>
      <p>螺栓與螺帽，緊扣在一起，無處不到。</p>
      <a href="/about" class="btn btn-dark">了解更多 →</a>
    </div>
    <div class="about-teaser-logo-wrap">
      <img src="/logo.png" alt="NCU BoltNut Robotics Logo" class="about-teaser-logo" />
    </div>
  </section>

  <section id="awards" class="home-section">
    <div class="row-head">
      <div>
        <span class="eyebrow">Awards</span>
        <h2>競賽成就</h2>
      </div>
      <a href="/achievements" class="row-head-link">查看完整成就 →</a>
    </div>
    <div class="ach-record" style="margin-bottom:0;">
      <span class="eyebrow" style="font-size:11px;">2026 國研盃智慧機械競賽</span>
      <h3 style="font-size:clamp(19px,2.3vw,24px); font-weight:700; color:var(--ink); line-height:1.3; margin-bottom:16px;">「NCU BoltNut 獵爪清道夫」正式參賽</h3>
      <p>在 2026 國研盃智慧機械競賽中展現紮實的機械設計與自動任務執行能力。<strong>江宜臻同學</strong>於英文演講競賽中榮獲<strong>第 2 名</strong>佳績。</p>
      <div class="robot-tags" style="margin-top:0;">
        <span>獵爪清道夫</span>
        <span>自動任務型</span>
        <span>2026.03.28</span>
      </div>
    </div>
  </section>

  <section id="sponsors" class="home-section">
    <div class="section-head" style="margin-bottom:32px;">
      <span class="eyebrow">Sponsors</span>
      <h2>贊助夥伴</h2>
    </div>
    <div class="sponsor-mini-grid">
      {sortedSponsors.map((sponsor) => (
        <div class="sponsor-mini-cell"><img src={sponsor.logo} alt={sponsor.name} /></div>
      ))}
    </div>
    <div class="sponsor-cta">
      <div>
        <h3>成為我們的贊助夥伴</h3>
        <p>與 BoltNut 一起支持機器人教育與工程人才培育</p>
      </div>
      <a href="/contact" class="btn btn-orange">聯絡我們 →</a>
    </div>
  </section>
</BaseLayout>
